<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Beeline">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ebe5d8">
    <%= csrf_meta_tags %>
    <meta name="beeline-root" content="<%= root_path %>">
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= root_path %>icon.png" type="image/png">
    <link rel="icon" href="<%= root_path %>icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= root_path %>icon.png">

    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%= tag.body class: [ ("native" if hotwire_native_app?), content_for(:body_class) ], data: {
        controller: "sync",
        sync_outbox_value: outbox_path,
        sync_shelf_value: root_path,
        sync_desk_value: papers_path,
        sync_worker_value: (pwa_service_worker_path(format: :js) unless hotwire_native_app?),
        sync_scope_value: root_path,
        action: "submit->sync#submit outbox:changed@window->sync#refresh online@window->sync#sync visibilitychange@document->sync#resume"
      } do %>
    <% unless hotwire_native_app? %>
      <header class="masthead">
        <%= link_to "Beeline", root_path, class: "masthead__name" %>

        <nav class="masthead__nav">
          <%= link_to "Shelf", root_path, class: "masthead__link", aria: { current: current_page?(root_path) || current_page?(shelf_path) ? "page" : nil } %>
          <%= link_to "Desk", papers_path, class: "masthead__link", aria: { current: current_page?(papers_path) ? "page" : nil } %>
          <%= link_to "New page", new_paper_path, class: "masthead__link masthead__link--new" %>
        </nav>
      </header>
    <% end %>

    <%= link_to "", outbox_path, class: "sync-status", hidden: true, data: { sync_target: "status" } %>

    <main class="main">
      <%= yield %>
    </main>
  <% end %>
</html>
