<button type="button" class="fullscreen-toggle" aria-pressed="false" aria-label="Full screen" title="Full screen"
        data-controller="fullscreen" data-action="fullscreen#toggle"
        data-fullscreen-enter-label-value="Full screen" data-fullscreen-leave-label-value="Leave full screen">
  <svg class="fullscreen-toggle__icon fullscreen-toggle__icon--enter" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" />
  </svg>
  <svg class="fullscreen-toggle__icon fullscreen-toggle__icon--leave" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M6 2v4H2M14 6h-4V2M10 14v-4h4M2 10h4v4" />
  </svg>
</button>
