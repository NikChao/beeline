<%= form_with model: draft, url: url, class: "typewriter", data: {
      offline: draft.paper&.persisted? ? "draft" : "page",
      controller: "typewriter",
      action: "lexxy:change->typewriter#typed mousemove@window->typewriter#rest submit->typewriter#submit outbox:queued->typewriter#queued beforeunload@window->typewriter#confirmLeaving turbo:before-visit@document->typewriter#confirmLeaving selectionchange@document->typewriter#selectionChanged"
    } do |form| %>
  <div class="page page--typescript">
    <div class="page__content">
      <p class="page__errors" data-typewriter-target="notice" <%= "hidden" if draft.errors.none? %>>
        <%= "#{draft.errors.full_messages.to_sentence}." if draft.errors.any? %>
      </p>

      <%= form.text_field :title, class: "page__title", placeholder: "Title", autocomplete: "off", required: true,
            autofocus: draft.title.blank?, aria: { label: "Title" }, data: { typewriter_target: "title", action: "keydown.enter->typewriter#next input->typewriter#remember" } %>
      <%= form.text_field :author, class: "page__author", placeholder: "Author", autocomplete: "off",
            aria: { label: "Author" }, data: { typewriter_target: "author", action: "keydown.enter->typewriter#next input->typewriter#remember" } %>

      <div class="page__body" data-action="keydown->typewriter#press:capture beforeinput->typewriter#input:capture cut->typewriter#refuse:capture dragstart->typewriter#refuse:capture drop->typewriter#refuse:capture">
        <%= form.rich_text_area :body, class: "lexxy-content", toolbar: false, attachments: false,
              autofocus: draft.title.present?, placeholder: "Start typing. There's no backspace.",
              aria: { label: "Body" }, data: { typewriter_target: "editor" } %>
      </div>
    </div>
  </div>

  <div class="format-bar" role="toolbar" aria-label="Format" hidden data-typewriter-target="formatBar">
    <button type="button" class="format-bar__button" aria-label="Bold" aria-pressed="false" data-typewriter-target="formatButton"
            data-action="pointerdown->typewriter#formatSelection:prevent" data-typewriter-format-param="bold"><b>B</b></button>
    <button type="button" class="format-bar__button" aria-label="Italic" aria-pressed="false" data-typewriter-target="formatButton"
            data-action="pointerdown->typewriter#formatSelection:prevent" data-typewriter-format-param="italic"><i>I</i></button>
    <button type="button" class="format-bar__button" aria-label="Strikethrough" aria-pressed="false" data-typewriter-target="formatButton"
            data-action="pointerdown->typewriter#formatSelection:prevent" data-typewriter-format-param="strikethrough"><s>S</s></button>
  </div>

  <footer class="typewriter__footer">
    <p class="typewriter__keys typewriter__keys--keyboard">
      <kbd>Ctrl B</kbd> bold <kbd>Ctrl I</kbd> italic <kbd>Ctrl U</kbd> underline <kbd>Ctrl Shift X</kbd> strike <kbd>#</kbd> heading <kbd>-</kbd> list
    </p>
    <p class="typewriter__keys typewriter__keys--touch">
      Select words to format <kbd>#</kbd> heading <kbd>-</kbd> list
    </p>

    <div class="typewriter__actions">
      <%= render "papers/drafts/fullscreen" %>
      <%= form.button "Save as draft", class: "button" %>
      <%= form.button "Publish", name: "publish", value: "1", class: "button button--primary" %>
    </div>
  </footer>
<% end %>
