<div class="tray" role="toolbar" aria-label="Pens">
  <div class="tray__group">
    <button type="button" class="tray__tool" data-markup-target="tool" data-action="markup#pick" data-markup-tool-param="line" title="Marker — strike or highlight a word (M)">
      <svg class="tray__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11" stroke-width="6" opacity="0.3" /><path d="M2.5 8h11" /></svg>
      <span class="tray__label">Marker</span>
    </button>
    <button type="button" class="tray__tool" data-markup-target="tool" data-action="markup#pick" data-markup-tool-param="stroke" title="Pen — draw freely (P)">
      <svg class="tray__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 10c2-5 3-5 4 0s2 5 4 0 2-5 4 0" /></svg>
      <span class="tray__label">Pen</span>
    </button>
    <button type="button" class="tray__tool" data-markup-target="tool" data-action="markup#pick" data-markup-tool-param="word" title="Word — click to place a word (W)">
      <svg class="tray__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5h9M8 3.5v9M6 12.5h4" /></svg>
      <span class="tray__label">Word</span>
    </button>
  </div>

  <div class="tray__group">
    <% Mark::COLORS.each.with_index(1) do |color, index| %>
      <button type="button" class="tray__color tray__color--<%= color %>" data-markup-target="color" data-action="markup#pick" data-markup-color-param="<%= color %>" title="<%= color.capitalize %> (<%= index %>)">
        <span class="visually-hidden"><%= color.capitalize %></span>
      </button>
    <% end %>
  </div>

  <button type="button" class="tray__tool tray__tool--undo" data-action="markup#undo" title="Take back your last mark (Ctrl Z). Marks dry when you leave the page.">
    <svg class="tray__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3 2.5 6l3 3M2.5 6h7a3.5 3.5 0 0 1 0 7H6" /></svg>
    <span class="tray__label">Undo</span>
  </button>
</div>
